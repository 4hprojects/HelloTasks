<%
  const statusBadge = s => s === 'completed' ? 'success' : s === 'blocked' ? 'danger' : s === 'in_progress' ? 'primary' : s === 'ready_for_review' ? 'info' : 'neutral';
  const fmtDate = d => d ? new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : null;
  const hasFilters = filters.status || filters.project || filters.showCompleted === '1';
%>

<div class="page-header">
  <div>
    <h1 class="page-title">My Tasks</h1>
    <p class="page-desc">Tasks assigned to you across all projects.</p>
  </div>
</div>

<!-- Filter bar -->
<form method="GET" action="/tasks/my-tasks" class="filter-bar">
  <select name="status" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All statuses</option>
    <% Object.entries(statusLabels).filter(([k]) => !['archived','completed'].includes(k)).forEach(([k, v]) => { %>
      <option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v %></option>
    <% }) %>
    <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
  </select>
  <select name="project" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All projects</option>
    <% projects.forEach(p => { %>
      <option value="<%= p._id %>" <%= filters.project === p._id.toString() ? 'selected' : '' %>><%= p.name %></option>
    <% }) %>
  </select>
  <select name="sort" class="form-select filter-select" onchange="this.form.submit()">
    <option value="dueDate"  <%= !filters.sort || filters.sort === 'dueDate'  ? 'selected' : '' %>>Due date</option>
    <option value="priority" <%= filters.sort === 'priority' ? 'selected' : '' %>>Priority</option>
  </select>
  <label class="filter-checkbox-label">
    <input type="checkbox" name="showCompleted" value="1" <%= filters.showCompleted === '1' ? 'checked' : '' %> onchange="this.form.submit()" />
    <span>Show completed</span>
  </label>
  <% if (hasFilters) { %>
    <a href="/tasks/my-tasks" class="btn btn--ghost btn--sm">Clear</a>
  <% } %>
</form>

<% if (total === 0) { %>
  <div class="panel">
    <div class="panel-body">
      <div class="proj-empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <p>No tasks assigned to you<% if (hasFilters) { %> matching these filters<% } %>.</p>
        <% if (hasFilters) { %><a href="/tasks/my-tasks" class="subtle-link">Clear filters</a><% } %>
      </div>
    </div>
  </div>
<% } else { %>

  <p class="results-count"><%= total %> task<%= total !== 1 ? 's' : '' %></p>

  <%
    function renderSection(sectionTasks, label, sectionClass) {
      if (sectionTasks.length === 0) return '';
      let html = `<div class="my-tasks-section">
        <h3 class="my-tasks-section-title ${sectionClass}">${label} <span class="my-tasks-section-count">${sectionTasks.length}</span></h3>
        <div class="panel">
          <div class="panel-body no-padding">
            <table class="data-table data-table--tasks">
              <thead>
                <tr>
                  <th>Task</th>
                  <th>Project</th>
                  <th>Status</th>
                  <th>Priority</th>
                  <th>Due</th>
                </tr>
              </thead>
              <tbody>`;

      sectionTasks.forEach(task => {
        const isOverdue = task.dueDate && new Date(task.dueDate) < new Date() && !['completed','archived'].includes(task.status);
        const dueFmt = fmtDate(task.dueDate);
        const sb = statusBadge(task.status);
        const pri = task.priority || 'medium';
        const priLabel = pri.charAt(0).toUpperCase() + pri.slice(1);
        const projectName = task.project ? task.project.name : '—';
        const projectId = task.project ? task.project._id : '';
        const taskUrl = projectId ? `/projects/${projectId}/tasks/${task._id}` : '#';
        const sl = statusLabels[task.status] || task.status;

        html += `<tr class="task-row">
          <td class="task-cell">
            <a href="${taskUrl}" class="task-link">${task.title}</a>
            ${task.isConfidential ? '<span class="badge badge--warning badge--xs">confidential</span>' : ''}
          </td>
          <td class="text-secondary text-sm">${projectName}</td>
          <td><span class="badge badge--${sb}">${sl}</span></td>
          <td>
            <span class="priority-cell">
              <span class="priority-dot priority-dot--${pri}"></span>
              <span class="priority-text">${priLabel}</span>
            </span>
          </td>
          <td class="${isOverdue ? 'text-danger' : 'text-secondary'} text-sm">${dueFmt || '—'}</td>
        </tr>`;
      });

      html += `</tbody></table></div></div></div>`;
      return html;
    }
  %>

  <%- renderSection(overdue,  'Overdue',       'my-tasks-section-title--danger') %>
  <%- renderSection(thisWeek, 'Due This Week',  'my-tasks-section-title--warning') %>
  <%- renderSection(later,    'Later & No Date','') %>

<% } %>
