<div class="locked-page">
  <a href="/projects/<%= project._id %>/tasks" class="back-link">← <%= project.name %> / Tasks</a>
  <div class="locked-hero">
    <div class="locked-icon">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="36" height="36" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
    </div>
    <h1 class="locked-title">Confidential Task</h1>
    <p class="locked-message">You don't have permission to view the details of this task.</p>
    <div class="locked-actions">
      <a href="/projects/<%= project._id %>/tasks" class="btn btn--primary btn--sm">Back to Tasks</a>
      <a href="/projects/<%= project._id %>" class="btn btn--ghost btn--sm">Back to Project</a>
    </div>
  </div>
</div>
