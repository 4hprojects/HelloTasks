<%
  const priorityColor = { critical:'var(--color-error)', high:'var(--color-warning)', medium:'var(--color-primary)', low:'var(--color-border)' }[task.priority] || 'var(--color-border)';
  const statusBadge   = { completed:'success', blocked:'danger', in_progress:'primary', ready_for_review:'info', approved:'success', returned:'warning' }[task.status] || 'neutral';
  const isOverdue     = task.dueDate && new Date(task.dueDate) < new Date() && task.status !== 'completed';
%>
<div class="task-page">

  <!-- Task hero -->
  <div class="task-show-hero" style="border-left-color: <%= priorityColor %>;">
    <div class="task-show-hero-left">
      <span class="priority-dot priority-dot--<%= task.priority %> priority-dot--lg"></span>
      <div class="task-show-hero-info">
        <div class="task-show-title-row">
          <h1 class="task-show-name"><%= task.title %></h1>
          <% if (task.isConfidential) { %><span class="badge badge--warning">Confidential</span><% } %>
          <% if (task.requiresLeadApproval) { %><span class="badge badge--neutral">Lead sign-off</span><% } %>
        </div>
        <div class="task-show-meta">
          <a href="/projects/<%= project._id %>/tasks" class="back-link" style="margin-bottom:0;font-size:0.8125rem;">← <%= project.name %> / Tasks</a>
          <span class="badge badge--<%= statusBadge %>"><%= statusLabels[task.status] %></span>
          <span class="task-show-priority-label"><%= task.priority.charAt(0).toUpperCase() + task.priority.slice(1) %> priority</span>
        </div>
      </div>
    </div>
    <% if (canEdit) { %>
    <div class="task-show-hero-actions">
      <a href="/projects/<%= project._id %>/tasks/<%= task._id %>/edit" class="btn btn--outline btn--sm">Edit</a>
      <% if (['super_admin','system_admin','project_lead','manager','owner'].includes(projectRole)) { %>
        <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/archive" class="inline-form" onsubmit="return confirm('Archive this task?')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--ghost btn--sm">Archive</button>
        </form>
        <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/delete" class="inline-form" onsubmit="return confirm('Permanently delete this task? This cannot be undone.')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn--danger btn--sm">Delete</button>
        </form>
      <% } %>
    </div>
    <% } %>
  </div>

  <div class="task-layout">

    <!-- Main content -->
    <div class="task-main">

      <% if (task.description) { %>
      <div class="panel">
        <div class="panel-header"><h3 class="panel-title">Description</h3></div>
        <div class="panel-body"><p class="task-description"><%= task.description %></p></div>
      </div>
      <% } %>

      <% if (task.checklist && task.checklist.length > 0) { %>
      <div class="panel">
        <div class="panel-header">
          <h3 class="panel-title">Checklist <span class="panel-title-count"><%= task.checklist.filter(c => c.completed).length %>/<%= task.checklist.length %></span></h3>
        </div>
        <div class="panel-body">
          <ul class="checklist">
            <% task.checklist.forEach(item => { %>
              <li class="checklist-item <%= item.completed ? 'completed' : '' %>">
                <span class="checklist-check">
                  <% if (item.completed) { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                  <% } else { %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16" aria-hidden="true"><circle cx="10" cy="10" r="7"/></svg>
                  <% } %>
                </span>
                <%= item.item %>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>
      <% } %>

      <!-- Status update -->
      <% if (availableTransitions.length > 0) { %>
      <div class="panel">
        <div class="panel-header"><h3 class="panel-title">Update Status</h3></div>
        <div class="panel-body">
          <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/status" class="status-update-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-row">
              <div class="form-group">
                <label for="newStatus" class="form-label">Move to</label>
                <select id="newStatus" name="newStatus" class="form-select">
                  <% availableTransitions.forEach(s => { %>
                    <option value="<%= s %>"><%= statusLabels[s] %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group" style="flex:2">
                <label for="statusNote" class="form-label">Note <span class="text-secondary">(optional)</span></label>
                <input type="text" id="statusNote" name="note" class="form-input" placeholder="Reason or context…" />
              </div>
            </div>
            <button type="submit" class="btn btn--primary btn--sm">Update Status</button>
          </form>
        </div>
      </div>
      <% } %>

      <!-- QA Review info -->
      <% if (task.qaReview && task.qaReview.reviewedBy) { %>
      <div class="panel">
        <div class="panel-header"><h3 class="panel-title">QA Review</h3></div>
        <div class="panel-body">
          <div class="review-block">
            <span class="badge badge--<%= task.qaReview.decision === 'approved' ? 'success' : 'warning' %>">
              <%= task.qaReview.decision === 'approved' ? 'Approved' : 'Returned for Refinement' %>
            </span>
            <span class="text-secondary text-sm">by <%= task.qaReview.reviewedBy.fullName %> on <%= new Date(task.qaReview.reviewedAt).toLocaleDateString() %></span>
            <% if (task.qaReview.note) { %><p class="review-note"><%= task.qaReview.note %></p><% } %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Lead approval info -->
      <% if (task.leadApproval && task.leadApproval.approvedBy) { %>
      <div class="panel">
        <div class="panel-header"><h3 class="panel-title">Lead Sign-off</h3></div>
        <div class="panel-body">
          <div class="review-block">
            <span class="badge badge--success">Approved</span>
            <span class="text-secondary text-sm">by <%= task.leadApproval.approvedBy.fullName %> on <%= new Date(task.leadApproval.approvedAt).toLocaleDateString() %></span>
            <% if (task.leadApproval.note) { %><p class="review-note"><%= task.leadApproval.note %></p><% } %>
          </div>
        </div>
      </div>
      <% } %>

      <!-- Status history (timeline) -->
      <div class="panel">
        <div class="panel-header"><h3 class="panel-title">History</h3></div>
        <div class="panel-body no-pad">
          <ol class="task-timeline">
            <% [...task.statusHistory].reverse().forEach(h => {
               const dotClass = { completed:'completed', in_progress:'in_progress', blocked:'blocked', ready_for_review:'ready_for_review', approved:'approved', returned:'returned' }[h.status] || 'default';
            %>
              <li class="timeline-item">
                <span class="timeline-dot timeline-dot--<%= dotClass %>"></span>
                <div class="timeline-body">
                  <span class="timeline-status"><%= statusLabels[h.status] || h.status %></span>
                  <div class="timeline-meta">
                    <% if (h.changedBy) { %>by <%= h.changedBy.fullName %> &middot; <% } %>
                    <%= new Date(h.changedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                  </div>
                  <% if (h.note) { %><p class="timeline-note"><%= h.note %></p><% } %>
                </div>
              </li>
            <% }) %>
          </ol>
        </div>
      </div>

      <!-- Files -->
      <div class="panel" id="files">
        <div class="panel-header">
          <h3 class="panel-title">Files <span class="panel-title-count"><%= files.length %></span></h3>
        </div>
        <% if (files.length > 0) { %>
          <div class="panel-body no-padding">
            <ul class="file-list">
              <% files.forEach(f => { %>
                <li class="file-item">
                  <div class="file-icon file-icon--<%= f.mimeType.startsWith('image/') ? 'image' : f.mimeType === 'application/pdf' ? 'pdf' : 'doc' %>">
                    <% if (f.mimeType.startsWith('image/')) { %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg>
                    <% } else if (f.mimeType === 'application/pdf') { %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/></svg>
                    <% } else { %>
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="20" height="20" aria-hidden="true"><path fill-rule="evenodd" d="M8 4a3 3 0 00-3 3v4a5 5 0 0010 0V7a1 1 0 112 0v4a7 7 0 11-14 0V7a5 5 0 0110 0v4a3 3 0 11-6 0V7a1 1 0 012 0v4a1 1 0 102 0V7a3 3 0 00-3-3z" clip-rule="evenodd"/></svg>
                    <% } %>
                  </div>
                  <div class="file-meta">
                    <a href="<%= f.publicUrl %>" target="_blank" rel="noopener noreferrer" class="file-name"><%= f.originalName %></a>
                    <span class="file-details"><%= formatSize(f.size) %> · Uploaded by <%= f.uploadedBy.fullName %> · <%= new Date(f.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></span>
                  </div>
                  <% const canDeleteFile = f.uploadedBy._id.toString() === user._id.toString() || ['super_admin','system_admin','project_lead','manager','owner'].includes(projectRole); %>
                  <% if (canDeleteFile) { %>
                    <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/files/<%= f._id %>/delete" class="inline-form" onsubmit="return confirm('Delete this file?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="file-delete-btn" title="Delete file" aria-label="Delete file">
                        <svg viewBox="0 0 20 20" fill="currentColor" width="15" height="15"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                      </button>
                    </form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <div class="panel-section">
          <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/files" enctype="multipart/form-data" class="upload-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="file" name="file" id="fileInput" class="file-input" accept="image/jpeg,image/png,image/webp,application/pdf,.doc,.docx,.xls,.xlsx,.csv,.ppt,.pptx,.txt,.md" required />
            <label for="fileInput" class="file-input-label">Choose file</label>
            <button type="submit" class="btn btn--primary btn--sm" id="uploadBtn" disabled>Upload</button>
          </form>
          <p class="form-hint mt-sm">Images up to 5 MB · Documents up to 10 MB · Converted to WebP automatically</p>
        </div>
      </div>

      <!-- Comments -->
      <div class="panel" id="comments">
        <div class="panel-header">
          <h3 class="panel-title">Comments <span class="panel-title-count"><%= comments.length %></span></h3>
        </div>
        <% if (comments.length > 0) { %>
          <div class="comments-list">
            <% comments.forEach(c => { %>
              <div class="comment">
                <div class="comment-header">
                  <div class="user-avatar user-avatar--sm"><%= c.author.fullName.charAt(0).toUpperCase() %></div>
                  <span class="comment-author"><%= c.author.fullName %></span>
                  <span class="comment-date"><%= new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                  <% const canDeleteComment = c.author._id.toString() === user._id.toString() || ['super_admin','system_admin','project_lead','manager','owner'].includes(projectRole); %>
                  <% if (canDeleteComment) { %>
                    <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/comments/<%= c._id %>/delete" class="inline-form comment-delete-form" onsubmit="return confirm('Delete this comment?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn--comment-delete" aria-label="Delete comment">×</button>
                    </form>
                  <% } %>
                </div>
                <%
                  let _body = c.content.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                  project.members.forEach(function(m) {
                    const _esc = m.user.fullName.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
                    _body = _body.replace(new RegExp('@'+_esc,'gi'),'<span class="mention">@'+m.user.fullName+'</span>');
                  });
                %>
                <p class="comment-body"><%- _body %></p>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="panel-body"><p class="empty-state">No comments yet.</p></div>
        <% } %>
        <div class="panel-section">
          <form method="POST" action="/projects/<%= project._id %>/tasks/<%= task._id %>/comments" class="comment-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mention-wrapper">
              <textarea id="commentContent" name="content" class="form-textarea comment-textarea" rows="3" placeholder="Add a comment… type @ to mention someone" required></textarea>
              <div id="mentionDropdown" class="mention-dropdown" style="display:none;"></div>
            </div>
            <div class="comment-form-actions">
              <button type="submit" class="btn btn--primary btn--sm">Post Comment</button>
            </div>
          </form>
        </div>
        <script>
        (function() {
          var textarea = document.getElementById('commentContent');
          var dropdown = document.getElementById('mentionDropdown');
          if (!textarea || !dropdown) return;

          var USERS = <%- JSON.stringify(project.members
            .filter(function(m){ return m.user._id.toString() !== user._id.toString(); })
            .map(function(m){ return { name: m.user.fullName }; })
          ) %>;

          var mentionStart = -1;

          function getQuery() {
            var val = textarea.value;
            var pos = textarea.selectionStart;
            for (var i = pos - 1; i >= 0 && pos - i <= 60; i--) {
              if (val[i] === '@') return { start: i, query: val.slice(i + 1, pos) };
              if (val[i] === '\n') return null;
            }
            return null;
          }

          function renderDropdown(matches) {
            dropdown.innerHTML = matches.slice(0, 6).map(function(u) {
              return '<div class="mention-option" tabindex="-1" data-name="' + u.name.replace(/"/g,'&quot;') + '">' + u.name + '</div>';
            }).join('');
            dropdown.style.display = 'block';
            dropdown.querySelectorAll('.mention-option').forEach(function(el) {
              el.addEventListener('mousedown', function(e) {
                e.preventDefault();
                insertMention(this.dataset.name);
              });
            });
          }

          function hideDropdown() {
            dropdown.style.display = 'none';
            mentionStart = -1;
          }

          function insertMention(name) {
            var val = textarea.value;
            var pos = textarea.selectionStart;
            var q = getQuery();
            if (!q) return;
            textarea.value = val.slice(0, q.start) + '@' + name + ' ' + val.slice(pos);
            var newPos = q.start + name.length + 2;
            textarea.setSelectionRange(newPos, newPos);
            textarea.focus();
            hideDropdown();
          }

          textarea.addEventListener('input', function() {
            var q = getQuery();
            if (!q) { hideDropdown(); return; }
            mentionStart = q.start;
            var search = q.query.toLowerCase();
            var matches = USERS.filter(function(u) { return u.name.toLowerCase().includes(search); });
            matches.length > 0 ? renderDropdown(matches) : hideDropdown();
          });

          textarea.addEventListener('keydown', function(e) {
            if (dropdown.style.display === 'none') return;
            var opts = dropdown.querySelectorAll('.mention-option');
            var focused = dropdown.querySelector('.mention-option:focus');
            if (e.key === 'Escape') { e.preventDefault(); hideDropdown(); }
            else if (e.key === 'ArrowDown') {
              e.preventDefault();
              (focused ? focused.nextElementSibling || opts[0] : opts[0]).focus();
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              (focused ? focused.previousElementSibling || opts[opts.length-1] : opts[opts.length-1]).focus();
            } else if (e.key === 'Enter' && focused) {
              e.preventDefault();
              insertMention(focused.dataset.name);
            }
          });

          document.addEventListener('click', function(e) {
            if (e.target !== textarea && !dropdown.contains(e.target)) hideDropdown();
          });
        })();
        </script>
      </div>

    </div>

    <!-- Sidebar meta -->
    <aside class="task-sidebar">

      <div class="meta-card">
        <div class="meta-row">
          <span class="meta-label">Status</span>
          <span class="badge badge--<%= statusBadge %>"><%= statusLabels[task.status] %></span>
        </div>
        <div class="meta-row">
          <span class="meta-label">Priority</span>
          <span class="meta-priority">
            <span class="priority-dot priority-dot--<%= task.priority %>"></span>
            <span><%= task.priority.charAt(0).toUpperCase() + task.priority.slice(1) %></span>
          </span>
        </div>
        <hr class="meta-divider" />
        <div class="meta-row">
          <span class="meta-label">Assignee</span>
          <% if (task.assignee) { %>
            <span class="meta-assignee">
              <span class="user-avatar user-avatar--sm"><%= task.assignee.fullName.charAt(0).toUpperCase() %></span>
              <span class="meta-value" style="text-align:left"><%= task.assignee.fullName %></span>
            </span>
          <% } else { %>
            <span class="meta-value text-muted">Unassigned</span>
          <% } %>
        </div>
        <div class="meta-row">
          <span class="meta-label">Created by</span>
          <span class="meta-value"><%= task.createdBy ? task.createdBy.fullName : '—' %></span>
        </div>
        <% if (task.dueDate) { %>
        <div class="meta-row">
          <span class="meta-label">Due</span>
          <span class="meta-value<%= isOverdue ? ' meta-value--overdue' : '' %>">
            <%= new Date(task.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %><% if (isOverdue) { %> &#9888;<% } %>
          </span>
        </div>
        <% } %>
        <div class="meta-row">
          <span class="meta-label">Created</span>
          <span class="meta-value"><%= new Date(task.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
        </div>
        <% if (task.externalUrl) { %>
        <hr class="meta-divider" />
        <div class="meta-row">
          <span class="meta-label">External URL</span>
          <a href="<%= task.externalUrl %>" target="_blank" rel="noopener noreferrer" class="meta-link">Open link ↗</a>
        </div>
        <% } %>
      </div>

    </aside>
  </div>
</div>
