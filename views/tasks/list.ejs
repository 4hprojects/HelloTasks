<div class="page-header">
  <div>
    <a href="/projects/<%= project._id %>" class="back-link">← <%= project.name %></a>
    <h2 class="page-subtitle">Tasks</h2>
  </div>
  <div class="header-actions">
    <a href="/projects/<%= project._id %>/kanban" class="btn btn--outline btn--sm">Kanban Board</a>
    <a href="/projects/<%= project._id %>/tasks/new" class="btn btn--primary btn--sm">+ New Task</a>
  </div>
</div>

<form method="GET" action="/projects/<%= project._id %>/tasks" class="filter-bar">
  <input type="text" name="search" class="form-input filter-search" placeholder="Search tasks…" value="<%= filters.search %>" />
  <select name="status" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All statuses</option>
    <% Object.entries(statusLabels).filter(([k]) => k !== 'archived').forEach(([k, v]) => { %>
      <option value="<%= k %>" <%= filters.status === k ? 'selected' : '' %>><%= v %></option>
    <% }) %>
  </select>
  <select name="priority" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All priorities</option>
    <option value="critical" <%= filters.priority === 'critical' ? 'selected' : '' %>>Critical</option>
    <option value="high"     <%= filters.priority === 'high'     ? 'selected' : '' %>>High</option>
    <option value="medium"   <%= filters.priority === 'medium'   ? 'selected' : '' %>>Medium</option>
    <option value="low"      <%= filters.priority === 'low'      ? 'selected' : '' %>>Low</option>
  </select>
  <select name="assigneeId" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All assignees</option>
    <option value="unassigned" <%= filters.assigneeId === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
    <% assignableUsers.forEach(u => { %>
      <option value="<%= u._id %>" <%= filters.assigneeId === u._id.toString() ? 'selected' : '' %>><%= u.fullName %></option>
    <% }) %>
  </select>
  <select name="sort" class="form-select filter-select" onchange="this.form.submit()">
    <option value="newest"   <%= filters.sort === 'newest' || !filters.sort ? 'selected' : '' %>>Newest first</option>
    <option value="due_asc"  <%= filters.sort === 'due_asc'  ? 'selected' : '' %>>Due date</option>
    <option value="priority" <%= filters.sort === 'priority' ? 'selected' : '' %>>Priority</option>
    <option value="status"   <%= filters.sort === 'status'   ? 'selected' : '' %>>Status</option>
  </select>
  <button type="submit" class="btn btn--outline btn--sm">Search</button>
  <% if (filters.search || filters.status || filters.priority || filters.assigneeId) { %>
    <a href="/projects/<%= project._id %>/tasks" class="btn btn--ghost btn--sm">Clear</a>
  <% } %>
</form>

<% if (tasks.length === 0) { %>
  <div class="panel">
    <div class="panel-body">
      <div class="proj-empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25z"/></svg>
        <p>No tasks found. <a href="/projects/<%= project._id %>/tasks/new" class="subtle-link">Create the first one.</a></p>
      </div>
    </div>
  </div>
<% } else { %>
  <p class="results-count"><%= tasks.length %> task<%= tasks.length !== 1 ? 's' : '' %></p>

  <% if (canBulk) { %>
  <form id="bulk-form" method="POST" action="/projects/<%= project._id %>/tasks/bulk">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div id="bulk-bar" class="bulk-bar" style="display:none;">
      <span id="bulk-count" class="bulk-count">0 tasks selected</span>
      <div class="bulk-actions">
        <select name="statusValue" class="form-select form-select--sm bulk-select">
          <option value="">— Status —</option>
          <% Object.entries(statusLabels).filter(([k]) => k !== 'archived').forEach(([k, v]) => { %>
            <option value="<%= k %>"><%= v %></option>
          <% }) %>
        </select>
        <button type="submit" name="action" value="status" class="btn btn--sm btn--outline bulk-btn">Set Status</button>
        <select name="priorityValue" class="form-select form-select--sm bulk-select">
          <option value="">— Priority —</option>
          <option value="critical">Critical</option>
          <option value="high">High</option>
          <option value="medium">Medium</option>
          <option value="low">Low</option>
        </select>
        <button type="submit" name="action" value="priority" class="btn btn--sm btn--outline bulk-btn">Set Priority</button>
        <button type="button" class="btn btn--ghost btn--sm" id="bulk-clear">Clear</button>
      </div>
    </div>

    <div class="panel">
      <div class="panel-body no-padding">
        <table class="data-table data-table--tasks">
          <thead>
            <tr>
              <th style="width:2.5rem;padding-left:1rem;"><input type="checkbox" id="bulk-select-all" title="Select all" /></th>
              <th>Task</th>
              <th>Status</th>
              <th>Priority</th>
              <th>Assignee</th>
              <th>Due</th>
            </tr>
          </thead>
          <tbody>
            <% tasks.forEach(task => { %>
              <% const isOverdue = task.dueDate && new Date(task.dueDate) < new Date() && !['completed','archived'].includes(task.status); %>
              <% if (!task.visible) { %>
                <tr>
                  <td></td>
                  <td colspan="5" class="confidential-row">
                    <span class="lock-icon">
                      <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                    </span>
                    Confidential task
                  </td>
                </tr>
              <% } else { %>
                <tr class="task-row<%= isOverdue ? ' row--overdue' : '' %>">
                  <td style="padding-left:1rem;"><input type="checkbox" name="taskIds" value="<%= task._id %>" class="bulk-checkbox" /></td>
                  <td class="task-cell">
                    <a href="/projects/<%= project._id %>/tasks/<%= task._id %>" class="task-link"><%= task.title %></a>
                    <% if (task.isConfidential) { %><span class="badge badge--warning badge--xs">confidential</span><% } %>
                  </td>
                  <td>
                    <span class="badge badge--<%= task.status === 'completed' ? 'success' : task.status === 'blocked' ? 'danger' : task.status === 'in_progress' ? 'primary' : task.status === 'ready_for_review' ? 'info' : 'neutral' %>">
                      <%= statusLabels[task.status] %>
                    </span>
                  </td>
                  <td>
                    <span class="priority-cell">
                      <span class="priority-dot priority-dot--<%= task.priority || 'medium' %>"></span>
                      <span class="priority-text"><%= (task.priority || 'medium').charAt(0).toUpperCase() + (task.priority || 'medium').slice(1) %></span>
                    </span>
                  </td>
                  <td>
                    <% if (task.assignee) { %>
                      <span class="assignee-cell">
                        <span class="user-avatar user-avatar--sm"><%= task.assignee.fullName.charAt(0).toUpperCase() %></span>
                        <span class="assignee-name"><%= task.assignee.fullName %></span>
                      </span>
                    <% } else { %>
                      <span class="text-muted">—</span>
                    <% } %>
                  </td>
                  <td class="<%= isOverdue ? 'text-danger' : 'text-secondary' %> text-sm">
                    <%= task.dueDate ? new Date(task.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—' %>
                  </td>
                </tr>
              <% } %>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </form>

  <script>
  (function () {
    const selectAll = document.getElementById('bulk-select-all');
    const bulkBar   = document.getElementById('bulk-bar');
    const bulkCount = document.getElementById('bulk-count');
    const checkboxes = () => document.querySelectorAll('.bulk-checkbox');

    function update() {
      const all = checkboxes();
      const checked = [...all].filter(c => c.checked);
      if (checked.length > 0) {
        bulkBar.style.display = '';
        bulkCount.textContent = `${checked.length} task${checked.length !== 1 ? 's' : ''} selected`;
      } else {
        bulkBar.style.display = 'none';
      }
      selectAll.indeterminate = checked.length > 0 && checked.length < all.length;
      selectAll.checked = all.length > 0 && checked.length === all.length;
    }

    selectAll.addEventListener('change', () => {
      checkboxes().forEach(cb => { cb.checked = selectAll.checked; });
      update();
    });
    document.querySelectorAll('.bulk-checkbox').forEach(cb => cb.addEventListener('change', update));
    document.getElementById('bulk-clear').addEventListener('click', () => {
      checkboxes().forEach(cb => { cb.checked = false; });
      selectAll.checked = false;
      update();
    });
  })();
  </script>

  <% } else { %>
  <div class="panel">
    <div class="panel-body no-padding">
      <table class="data-table data-table--tasks">
        <thead>
          <tr>
            <th>Task</th>
            <th>Status</th>
            <th>Priority</th>
            <th>Assignee</th>
            <th>Due</th>
          </tr>
        </thead>
        <tbody>
          <% tasks.forEach(task => { %>
            <% const isOverdue = task.dueDate && new Date(task.dueDate) < new Date() && !['completed','archived'].includes(task.status); %>
            <% if (!task.visible) { %>
              <tr>
                <td colspan="5" class="confidential-row">
                  <span class="lock-icon">
                    <svg viewBox="0 0 20 20" fill="currentColor" width="13" height="13"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
                  </span>
                  Confidential task
                </td>
              </tr>
            <% } else { %>
              <tr class="task-row<%= isOverdue ? ' row--overdue' : '' %>">
                <td class="task-cell">
                  <a href="/projects/<%= project._id %>/tasks/<%= task._id %>" class="task-link"><%= task.title %></a>
                  <% if (task.isConfidential) { %><span class="badge badge--warning badge--xs">confidential</span><% } %>
                </td>
                <td>
                  <span class="badge badge--<%= task.status === 'completed' ? 'success' : task.status === 'blocked' ? 'danger' : task.status === 'in_progress' ? 'primary' : task.status === 'ready_for_review' ? 'info' : 'neutral' %>">
                    <%= statusLabels[task.status] %>
                  </span>
                </td>
                <td>
                  <span class="priority-cell">
                    <span class="priority-dot priority-dot--<%= task.priority || 'medium' %>"></span>
                    <span class="priority-text"><%= (task.priority || 'medium').charAt(0).toUpperCase() + (task.priority || 'medium').slice(1) %></span>
                  </span>
                </td>
                <td>
                  <% if (task.assignee) { %>
                    <span class="assignee-cell">
                      <span class="user-avatar user-avatar--sm"><%= task.assignee.fullName.charAt(0).toUpperCase() %></span>
                      <span class="assignee-name"><%= task.assignee.fullName %></span>
                    </span>
                  <% } else { %>
                    <span class="text-muted">—</span>
                  <% } %>
                </td>
                <td class="<%= isOverdue ? 'text-danger' : 'text-secondary' %> text-sm">
                  <%= task.dueDate ? new Date(task.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—' %>
                </td>
              </tr>
            <% } %>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
<% } %>
