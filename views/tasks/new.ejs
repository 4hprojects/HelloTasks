<div class="task-form-header">
  <a href="/projects/<%= project._id %>" class="back-link">← <%= project.name %></a>
  <div class="task-form-header-inner">
    <div class="task-form-header-icon">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
    </div>
    <div>
      <h1 class="task-form-title">New Task</h1>
      <p class="task-form-subtitle"><%= project.name %></p>
    </div>
  </div>
</div>

<% if (errors && errors.length) { %>
  <% errors.forEach(e => { %><div class="alert alert--error"><span><%= e %></span></div><% }) %>
<% } %>

<form method="POST" action="/projects/<%= project._id %>/tasks" class="task-form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Main fields -->
  <div class="task-form-main">
    <div class="panel">
      <div class="panel-header"><h3 class="panel-title">Task Details</h3></div>
      <div class="panel-body form-stack">

        <div class="form-group">
          <label for="title" class="form-label">Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" class="form-input" required placeholder="What needs to be done?" value="<%= typeof body !== 'undefined' && body.title ? body.title : '' %>" />
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Description <span class="form-label-optional">optional</span></label>
          <textarea id="description" name="description" class="form-textarea" rows="5" placeholder="Details, context, acceptance criteria…"><%= typeof body !== 'undefined' && body.description ? body.description : '' %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Checklist Items <span class="form-label-optional">optional</span></label>
          <div id="checklistContainer" class="checklist-builder">
            <div class="checklist-item-row">
              <input type="text" name="checklistItems" class="form-input" placeholder="Checklist item…" />
              <button type="button" class="checklist-remove-btn" onclick="removeChecklistRow(this)" aria-label="Remove">
                <svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
              </button>
            </div>
          </div>
          <button type="button" class="btn btn--ghost btn--sm mt-sm" onclick="addChecklistRow()">+ Add item</button>
        </div>

      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <aside class="task-form-sidebar">
    <div class="panel">
      <div class="panel-header"><h3 class="panel-title">Properties</h3></div>
      <div class="panel-body form-stack">

        <div class="form-group">
          <label for="assigneeId" class="form-label">Assignee</label>
          <select id="assigneeId" name="assigneeId" class="form-select">
            <option value="">Unassigned</option>
            <% assignableUsers.forEach(u => { %>
              <option value="<%= u._id %>" <%= typeof body !== 'undefined' && body.assigneeId === u._id.toString() ? 'selected' : '' %>><%= u.fullName %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label for="priority" class="form-label">Priority</label>
          <select id="priority" name="priority" class="form-select">
            <option value="low">Low</option>
            <option value="medium" selected>Medium</option>
            <option value="high">High</option>
            <option value="critical">Critical</option>
          </select>
        </div>

        <div class="form-group">
          <label for="dueDate" class="form-label">Due Date</label>
          <input type="date" id="dueDate" name="dueDate" class="form-input" value="<%= typeof body !== 'undefined' && body.dueDate ? body.dueDate : '' %>" />
        </div>

        <div class="form-group">
          <label for="externalUrl" class="form-label">External URL</label>
          <input type="url" id="externalUrl" name="externalUrl" class="form-input" placeholder="https://…" value="<%= typeof body !== 'undefined' && body.externalUrl ? body.externalUrl : '' %>" />
          <span class="form-hint">Must start with http:// or https://</span>
        </div>

        <hr class="meta-divider" />

        <div class="form-flags">
          <label class="form-checkbox-label">
            <input type="checkbox" name="isConfidential" value="on" <%= typeof body !== 'undefined' && body.isConfidential === 'on' ? 'checked' : '' %> />
            <span>
              Confidential
              <span class="form-hint">Hidden from users without task access</span>
            </span>
          </label>
          <label class="form-checkbox-label">
            <input type="checkbox" name="requiresLeadApproval" value="on" <%= typeof body !== 'undefined' && body.requiresLeadApproval === 'on' ? 'checked' : '' %> />
            <span>
              Lead sign-off required
              <span class="form-hint">Won't auto-complete after QA approval</span>
            </span>
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary" data-loading-text="Creating...">Create Task</button>
          <a href="/projects/<%= project._id %>" class="btn btn--ghost">Cancel</a>
        </div>

      </div>
    </div>
  </aside>

</form>

<script>
function addChecklistRow() {
  const container = document.getElementById('checklistContainer');
  const row = document.createElement('div');
  row.className = 'checklist-item-row';
  row.innerHTML = '<input type="text" name="checklistItems" class="form-input" placeholder="Checklist item…" /><button type="button" class="checklist-remove-btn" onclick="removeChecklistRow(this)" aria-label="Remove"><svg viewBox="0 0 20 20" fill="currentColor" width="14" height="14"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></button>';
  container.appendChild(row);
  row.querySelector('input').focus();
}
function removeChecklistRow(btn) {
  const container = document.getElementById('checklistContainer');
  if (container.children.length > 1) btn.closest('.checklist-item-row').remove();
  else btn.closest('.checklist-item-row').querySelector('input').value = '';
}
</script>
