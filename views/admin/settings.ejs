<div class="page-header">
  <div>
    <h1 class="page-title">Settings</h1>
    <p class="page-desc">App configuration, system info, and admin tools.</p>
  </div>
</div>

<div class="admin-layout">

  <!-- App Settings -->
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">App Settings</h2>
    </div>
    <div class="panel-body">
      <form method="POST" action="/admin/settings" novalidate class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="appName" class="form-label">App Name</label>
          <input type="text" id="appName" name="appName" class="form-input" value="<%= settings.appName %>" placeholder="HelloTasks" />
          <p class="form-hint">Used in email subject lines and footers.</p>
        </div>
        <div class="form-group">
          <label for="supportEmail" class="form-label">Support Email</label>
          <input type="email" id="supportEmail" name="supportEmail" class="form-input" value="<%= settings.supportEmail %>" placeholder="support@hellotasks.online" />
          <p class="form-hint">Shown to users when they need help.</p>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="openRegistration" <%= settings.openRegistration ? 'checked' : '' %> />
            <span>Open Registration</span>
          </label>
          <p class="form-hint" style="margin-top:0.375rem;">When enabled, anyone can register. An admin activates accounts after review.</p>
        </div>
        <div class="form-group">
          <label for="weeklyReportNote" class="form-label">Weekly Report Note <span class="form-label-optional">(optional)</span></label>
          <textarea id="weeklyReportNote" name="weeklyReportNote" class="form-textarea" rows="3" placeholder="A short note included at the top of each weekly report email."><%= settings.weeklyReportNote %></textarea>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="weeklyReportAutoSend" <%= settings.weeklyReportAutoSend ? 'checked' : '' %> />
            <span>Auto-send weekly report every Monday at 08:00 UTC</span>
          </label>
          <p class="form-hint" style="margin-top:0.375rem;">When enabled, the report is automatically emailed to all active Super Admins and Project Leads every Monday morning.</p>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Save Settings</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Weekly Report -->
  <div class="panel">
    <div class="panel-header">
      <h2 class="panel-title">Weekly Report</h2>
    </div>
    <div class="panel-body">
      <p class="panel-desc">Sends a project and task summary email to all active System Admins and Project Leads.</p>
      <dl class="detail-list" style="margin-bottom:1.5rem;">
        <dt>Recipients</dt>
        <dd>All active System Admins + Project Leads</dd>
        <dt>Contents</dt>
        <dd>Overall stats, completed this week, tasks in review, blocked tasks, per-project breakdown</dd>
        <dt>Delivery</dt>
        <dd>HTML email via Resend</dd>
      </dl>
      <a href="/admin/weekly-report/preview" class="btn btn--primary btn--sm">Preview &amp; Send Report</a>
    </div>
  </div>

  <!-- System Info -->
  <div class="panel">
    <div class="panel-header"><h2 class="panel-title">System Info</h2></div>
    <div class="panel-body">
      <dl class="detail-list">
        <dt>Node.js</dt><dd><%= process.version %></dd>
        <dt>Environment</dt><dd><span class="badge badge--<%= (process.env.APP_ENV || 'development') === 'production' ? 'success' : 'neutral' %>"><%= process.env.APP_ENV || 'development' %></span></dd>
        <dt>App URL</dt><dd class="text-secondary text-sm"><%= process.env.APP_URL || 'http://localhost:3000' %></dd>
        <dt>Database</dt><dd>MongoDB (Mongoose)</dd>
        <dt>File Storage</dt><dd>Supabase Storage</dd>
        <dt>Email</dt><dd>Resend</dd>
      </dl>
    </div>
  </div>

  <!-- Danger Zone -->
  <div class="panel panel--danger">
    <div class="panel-header">
      <h2 class="panel-title panel-title--danger">Danger Zone</h2>
    </div>
    <div class="panel-body">
      <div class="danger-item">
        <div>
          <strong>Open Registration</strong>
          <p class="form-hint">Disable open registration to prevent new self-registrations. Existing accounts are unaffected.</p>
        </div>
        <form method="POST" action="/admin/settings" data-confirm="Toggle open registration?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="appName" value="<%= settings.appName %>" />
          <input type="hidden" name="supportEmail" value="<%= settings.supportEmail %>" />
          <input type="hidden" name="weeklyReportNote" value="<%= settings.weeklyReportNote %>" />
          <% if (settings.weeklyReportAutoSend) { %><input type="hidden" name="weeklyReportAutoSend" value="on" /><% } %>
          <% if (settings.openRegistration) { %>
            <button type="submit" class="btn btn--sm btn--danger-outline">Disable Registration</button>
          <% } else { %>
            <input type="hidden" name="openRegistration" value="on" />
            <button type="submit" class="btn btn--sm btn--outline">Enable Registration</button>
          <% } %>
        </form>
      </div>
    </div>
  </div>

</div>
