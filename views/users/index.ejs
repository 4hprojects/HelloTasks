<div class="page-header">
  <div>
    <h1 class="page-subtitle">User Management</h1>
    <p class="page-desc">Manage accounts, roles, and access.</p>
  </div>
  <a href="/users/invite" class="btn btn--primary btn--sm">+ Invite User</a>
</div>

<form class="filter-bar" method="GET" action="/users">
  <input type="text" name="search" class="form-input filter-search" placeholder="Search name or email…" value="<%= filters.search || '' %>" />
  <select name="role" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All Roles</option>
    <optgroup label="Current">
      <option value="system_admin"    <%= filters.role === 'system_admin'    ? 'selected' : '' %>>System Admin</option>
      <option value="owner"           <%= filters.role === 'owner'           ? 'selected' : '' %>>Owner</option>
      <option value="manager"         <%= filters.role === 'manager'         ? 'selected' : '' %>>Manager</option>
      <option value="quality_manager" <%= filters.role === 'quality_manager' ? 'selected' : '' %>>Quality Manager</option>
      <option value="member"          <%= filters.role === 'member'          ? 'selected' : '' %>>Member</option>
      <option value="viewer"          <%= filters.role === 'viewer'          ? 'selected' : '' %>>Viewer</option>
    </optgroup>
    <optgroup label="Legacy">
      <option value="super_admin"  <%= filters.role === 'super_admin'  ? 'selected' : '' %>>super_admin</option>
      <option value="project_lead" <%= filters.role === 'project_lead' ? 'selected' : '' %>>project_lead</option>
      <option value="developer"    <%= filters.role === 'developer'    ? 'selected' : '' %>>developer</option>
    </optgroup>
  </select>
  <select name="status" class="form-select filter-select" onchange="this.form.submit()">
    <option value="">All Statuses</option>
    <option value="pending"   <%= filters.status === 'pending'   ? 'selected' : '' %>>Pending</option>
    <option value="active"    <%= filters.status === 'active'    ? 'selected' : '' %>>Active</option>
    <option value="suspended" <%= filters.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
  </select>
  <button type="submit" class="btn btn--outline btn--sm">Search</button>
  <% if (filters.search || filters.role || filters.status) { %>
    <a href="/users" class="btn btn--ghost btn--sm">Clear</a>
  <% } %>
</form>

<% if (users.length === 0) { %>
  <div class="panel">
    <div class="panel-body">
      <div class="proj-empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="40" height="40"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
        <p>No users found<% if (filters.search || filters.role || filters.status) { %> matching your filters<% } %>.</p>
      </div>
    </div>
  </div>
<% } else { %>
  <p class="results-count"><%= users.length %> user<%= users.length !== 1 ? 's' : '' %></p>
  <div class="panel">
    <div class="panel-body no-padding">
      <table class="data-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Role</th>
            <th>Status</th>
            <th>Joined</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <%
              const _rb = { system_admin:'danger', super_admin:'danger', owner:'danger', manager:'primary', project_lead:'primary', quality_manager:'info', member:'success', developer:'success', viewer:'neutral' };
              const isSelf = u._id.toString() === user._id.toString();
              const isSuspended = u.accountStatus === 'suspended';
            %>
            <tr class="<%= isSuspended ? 'user-row--suspended' : '' %>">
              <td>
                <div class="user-name-cell">
                  <div class="user-avatar user-avatar--sm user-avatar--<%= u.accountStatus %>">
                    <%= u.fullName.charAt(0).toUpperCase() %>
                  </div>
                  <div class="user-cell-info">
                    <span class="user-table-name">
                      <%= u.fullName %>
                      <% if (isSelf) { %><span class="self-tag">(you)</span><% } %>
                    </span>
                    <span class="user-cell-email"><%= u.email %></span>
                  </div>
                </div>
              </td>
              <td>
                <span class="badge badge--<%= _rb[u.globalRole] || 'neutral' %>">
                  <%= roleLabels[u.globalRole] || u.globalRole %>
                </span>
              </td>
              <td>
                <span class="badge badge--<%= u.accountStatus === 'active' ? 'success' : u.accountStatus === 'suspended' ? 'danger' : 'neutral' %>">
                  <%= u.accountStatus %>
                </span>
              </td>
              <td class="text-secondary text-sm">
                <%= new Date(u.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </td>
              <td>
                <a href="/users/<%= u._id %>" class="proj-edit-btn" title="Manage user">
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>
