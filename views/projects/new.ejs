<div class="form-page">
  <div class="form-page-header">
    <a href="/projects" class="back-link">← Projects</a>
    <h2>New Project</h2>
  </div>

  <% if (errors && errors.length) { %>
    <% errors.forEach(e => { %>
      <div class="alert alert--error"><span><%= e %></span></div>
    <% }) %>
  <% } %>

  <div class="panel">
    <div class="panel-body">
      <form method="POST" action="/projects/new" class="form-stack">

        <div class="form-group">
          <label for="name" class="form-label">Project Name <span class="required">*</span></label>
          <input
            type="text"
            id="name"
            name="name"
            class="form-input"
            required
            placeholder="e.g. HelloTasks Redesign"
            value="<%= typeof body !== 'undefined' && body.name ? body.name : '' %>"
          />
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Description</label>
          <textarea
            id="description"
            name="description"
            class="form-textarea"
            rows="3"
            placeholder="Brief description of the project..."
          ><%= typeof body !== 'undefined' && body.description ? body.description : '' %></textarea>
        </div>

        <div class="form-group">
          <label for="status" class="form-label">Status</label>
          <select id="status" name="status" class="form-select">
            <option value="active" <%= typeof body !== 'undefined' && body.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="on_hold" <%= typeof body !== 'undefined' && body.status === 'on_hold' ? 'selected' : '' %>>On Hold</option>
            <option value="completed" <%= typeof body !== 'undefined' && body.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="archived" <%= typeof body !== 'undefined' && body.status === 'archived' ? 'selected' : '' %>>Archived</option>
          </select>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary">Create Project</button>
          <a href="/projects" class="btn btn--ghost">Cancel</a>
        </div>

      </form>
    </div>
  </div>
</div>
