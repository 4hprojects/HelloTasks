<%
  const avatarColors = ['proj-avatar--blue','proj-avatar--green','proj-avatar--purple','proj-avatar--amber','proj-avatar--red'];
  const initials     = project.name.replace(/[^A-Za-z0-9 ]/g,'').split(' ').filter(Boolean).slice(0,2).map(w=>w[0].toUpperCase()).join('') || '?';
  const avatarClass  = avatarColors[project.name.charCodeAt(0) % 5];
  const statusBadge  = { active:'success', on_hold:'warning', completed:'primary', archived:'neutral' }[project.status] || 'neutral';
  const statusLabel  = { active:'Active', on_hold:'On Hold', completed:'Completed', archived:'Archived' }[project.status] || project.status;
%>

<div class="task-form-header">
  <a href="/projects/<%= project._id %>" class="back-link">← <%= project.name %></a>
  <div class="task-form-header-inner">
    <div class="task-form-header-icon">
      <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
    </div>
    <div>
      <h1 class="task-form-title">Edit Project</h1>
      <p class="task-form-subtitle">Hello Ecosystem</p>
    </div>
  </div>
</div>

<% if (errors && errors.length) { %>
  <% errors.forEach(e => { %><div class="alert alert--error"><span><%= e %></span></div><% }) %>
<% } %>

<form method="POST" action="/projects/<%= project._id %>/edit" class="task-form-layout">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Main fields -->
  <div class="task-form-main">
    <div class="panel">
      <div class="panel-header"><h3 class="panel-title">Project Details</h3></div>
      <div class="panel-body form-stack">

        <div class="form-group">
          <label for="name" class="form-label">Project Name <span class="required">*</span></label>
          <input type="text" id="name" name="name" class="form-input" required value="<%= project.name %>" />
        </div>

        <div class="form-group">
          <label for="description" class="form-label">Description</label>
          <textarea id="description" name="description" class="form-textarea" rows="4" placeholder="Brief description of the project…"><%= project.description %></textarea>
        </div>

      </div>
    </div>
  </div>

  <!-- Sidebar -->
  <aside class="task-form-sidebar">
    <div class="panel">
      <div class="panel-header"><h3 class="panel-title">Settings</h3></div>
      <div class="panel-body form-stack">

        <div class="form-group">
          <label for="status" class="form-label">Status</label>
          <select id="status" name="status" class="form-select">
            <option value="active"    <%= project.status === 'active'    ? 'selected' : '' %>>Active</option>
            <option value="on_hold"   <%= project.status === 'on_hold'   ? 'selected' : '' %>>On Hold</option>
            <option value="completed" <%= project.status === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="archived"  <%= project.status === 'archived'  ? 'selected' : '' %>>Archived</option>
          </select>
        </div>

        <!-- Live preview -->
        <div class="proj-form-preview">
          <p class="proj-form-preview-label">Card preview</p>
          <div class="proj-form-preview-card">
            <div class="proj-form-preview-top">
              <div id="previewAvatar" class="proj-avatar proj-avatar--lg <%= avatarClass %>"><%= initials %></div>
              <span id="previewStatus" class="badge badge--<%= statusBadge %>"><%= statusLabel %></span>
            </div>
            <p id="previewName" class="proj-form-preview-name"><%= project.name %></p>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn--primary" data-loading-text="Saving...">Save Changes</button>
          <a href="/projects/<%= project._id %>" class="btn btn--ghost">Cancel</a>
        </div>

      </div>
    </div>
  </aside>

</form>

<script>
(function() {
  var avatarColors = ['proj-avatar--blue','proj-avatar--green','proj-avatar--purple','proj-avatar--amber','proj-avatar--red'];
  var statusBadgeMap = { active:'success', on_hold:'warning', completed:'primary', archived:'neutral' };
  var statusLabelMap = { active:'Active', on_hold:'On Hold', completed:'Completed', archived:'Archived' };

  function updatePreview() {
    var name   = document.getElementById('name').value.trim();
    var status = document.getElementById('status').value;

    var words    = name.replace(/[^A-Za-z0-9 ]/g,'').split(' ').filter(Boolean);
    var initials = words.slice(0,2).map(function(w){ return w[0].toUpperCase(); }).join('') || '?';
    var colorClass = name ? avatarColors[name.charCodeAt(0) % 5] : 'proj-avatar--blue';

    var avatarEl = document.getElementById('previewAvatar');
    avatarEl.textContent = initials;
    avatarEl.className = 'proj-avatar proj-avatar--lg ' + colorClass;

    document.getElementById('previewName').textContent = name || 'Project Name';

    var badge = document.getElementById('previewStatus');
    badge.textContent = statusLabelMap[status] || status;
    badge.className   = 'badge badge--' + (statusBadgeMap[status] || 'neutral');
  }

  document.getElementById('name').addEventListener('input', updatePreview);
  document.getElementById('status').addEventListener('change', updatePreview);
})();
</script>
