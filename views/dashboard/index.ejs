<div class="dashboard">

  <div class="dash-greeting">
    <div>
      <h2 class="dash-greeting-name"><%= greeting %>, <%= firstName %></h2>
      <p class="dash-greeting-date"><%= new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }) %></p>
    </div>
  </div>

  <div class="stats-grid">

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">Total Projects</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
        </span>
      </div>
      <div class="stat-value"><%= stats.totalProjects %></div>
    </div>

    <div class="stat-card">
      <div class="stat-header">
        <span class="stat-label">My Tasks</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
        </span>
      </div>
      <div class="stat-value"><a href="/tasks" class="stat-link"><%= stats.myTasks %></a></div>
    </div>

    <div class="stat-card stat-card--warning">
      <div class="stat-header">
        <span class="stat-label">Due Within 7 Days</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
        </span>
      </div>
      <div class="stat-value"><%= stats.dueSoon %></div>
    </div>

    <div class="stat-card stat-card--info">
      <div class="stat-header">
        <span class="stat-label">Ready for Review</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/></svg>
        </span>
      </div>
      <div class="stat-value"><%= stats.readyForReview %></div>
    </div>

    <div class="stat-card stat-card--danger">
      <div class="stat-header">
        <span class="stat-label">Blocked</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
        </span>
      </div>
      <div class="stat-value"><%= stats.blocked %></div>
    </div>

    <div class="stat-card stat-card--success">
      <div class="stat-header">
        <span class="stat-label">Completed (30d)</span>
        <span class="stat-icon">
          <svg viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        </span>
      </div>
      <div class="stat-value"><%= stats.completedRecently %></div>
    </div>

  </div>

  <div class="dashboard-panels">

    <div class="panel">
      <div class="panel-header">
        <h2 class="panel-title">My Assigned Tasks</h2>
        <a href="/tasks" class="btn btn--sm btn--outline">View All</a>
      </div>
      <% if (recentTasks.length === 0) { %>
        <div class="panel-body"><p class="empty-state">No tasks assigned to you.</p></div>
      <% } else { %>
        <div class="panel-body no-padding">
          <table class="data-table">
            <thead>
              <tr><th>Task</th><th>Project</th><th>Status</th><th>Due</th></tr>
            </thead>
            <tbody>
              <% recentTasks.forEach(t => { %>
                <tr>
                  <td><a href="/projects/<%= t.project._id %>/tasks/<%= t._id %>" class="task-link"><%= t.title %></a></td>
                  <td class="text-secondary"><%= t.project.name %></td>
                  <td>
                    <span class="badge badge--<%= t.status === 'completed' ? 'success' : t.status === 'blocked' ? 'danger' : t.status === 'in_progress' ? 'primary' : t.status === 'ready_for_review' ? 'info' : 'neutral' %>">
                      <%= statusLabels[t.status] || t.status %>
                    </span>
                  </td>
                  <td class="text-secondary"><%= t.dueDate ? new Date(t.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <div class="panel">
      <div class="panel-header">
        <h2 class="panel-title">Quick Links</h2>
      </div>
      <div class="panel-body">
        <div class="quick-links">
          <a href="/projects" class="quick-link-item">
            <svg class="quick-link-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/></svg>
            <span>Projects</span>
          </a>
          <a href="/tasks" class="quick-link-item">
            <svg class="quick-link-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/><path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/></svg>
            <span>All My Tasks</span>
          </a>
          <a href="/notifications" class="quick-link-item">
            <svg class="quick-link-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/></svg>
            <span>Notifications<% if (unreadCount > 0) { %> <span class="notif-count"><%= unreadCount %></span><% } %></span>
          </a>
          <% if (['super_admin','system_admin','owner','manager','project_lead'].includes(user.globalRole) || user.systemRole === 'system_admin') { %>
          <a href="/users" class="quick-link-item">
            <svg class="quick-link-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <span>User Management</span>
          </a>
          <% } %>
          <% if (['super_admin','system_admin'].includes(user.globalRole) || user.systemRole === 'system_admin') { %>
          <a href="/admin/settings" class="quick-link-item">
            <svg class="quick-link-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/></svg>
            <span>Settings</span>
          </a>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</div>
