<div class="auth-card">
  <div class="auth-header">
    <img src="/HelloTasksIcon.png" alt="HelloTasks" class="auth-logo">
    <div class="auth-card-icon">
      <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22"><path fill-rule="evenodd" d="M18 8a6 6 0 01-7.743 5.743L10 14l-1 1-1 1H6v2H2v-4l4.257-4.257A6 6 0 1118 8zm-6-4a1 1 0 100 2 2 2 0 012 2 1 1 0 102 0 4 4 0 00-4-4z" clip-rule="evenodd"/></svg>
    </div>
    <h1 class="auth-title">Set New Password</h1>
    <p class="auth-subtitle">Choose a strong password for your account</p>
  </div>

  <form method="POST" action="/reset-password/<%= token %>" class="auth-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'password' }) %>
        <label for="password" class="form-label">New Password</label>
      </div>
      <span class="form-hint">Min. 8 characters</span>
    </div>
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="form-input"
          required
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'confirmPassword' }) %>
        <label for="confirmPassword" class="form-label">Confirm Password</label>
      </div>
      <span class="form-error confirm-password-error" style="display:none">Passwords do not match.</span>
    </div>
    <button type="submit" class="btn btn--primary btn--full" data-loading-text="Updating password...">Update Password</button>
  </form>

  <p class="auth-footer"><a href="/login">← Back to Sign In</a></p>
</div>
