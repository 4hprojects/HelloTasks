<div class="auth-card">
  <div class="auth-header">
    <img src="/HelloTasksIcon.png" alt="HelloTasks" class="auth-logo">
    <h1 class="auth-title">HelloTasks</h1>
    <p class="auth-subtitle">Welcome back — sign in to continue</p>
  </div>

  <form method="POST" action="/login" class="auth-form" novalidate>
    <div class="form-group">
      <div class="form-float">
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          required
          autocomplete="email"
          placeholder=" "
        />
        <label for="email" class="form-label">Email</label>
      </div>
    </div>
    <div class="form-group">
      <div class="auth-password-row">
        <a href="/forgot-password" class="auth-forgot-inline">Forgot password?</a>
      </div>
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          required
          autocomplete="current-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'password' }) %>
        <label for="password" class="form-label">Password</label>
      </div>
    </div>
    <button type="submit" class="btn btn--primary btn--full" data-loading-text="Signing in...">Sign In</button>
  </form>

  <p class="auth-footer">Don't have an account? <a href="/register">Create one</a></p>
</div>
