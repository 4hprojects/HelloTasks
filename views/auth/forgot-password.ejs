<div class="auth-card">
  <div class="auth-header">
    <img src="/HelloTasksIcon.png" alt="HelloTasks" class="auth-logo">
    <h1 class="auth-title">Reset Password</h1>
    <p class="auth-subtitle">No worries — we'll send you a secure reset link.</p>
  </div>

  <form method="POST" action="/forgot-password" class="auth-form" novalidate>
    <div class="form-group">
      <div class="form-float">
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          required
          autocomplete="email"
          placeholder=" "
        />
        <label for="email" class="form-label">Email</label>
      </div>
    </div>
    <button type="submit" class="btn btn--primary btn--full" data-loading-text="Sending...">Send Reset Link</button>
    <p class="auth-hint">Check your spam folder if it doesn't arrive within a few minutes.</p>
  </form>

  <p class="auth-footer"><a href="/login">Back to Sign In</a></p>
</div>
