<div class="auth-card">
  <div class="auth-header">
    <div class="auth-logo">HT</div>
    <h1 class="auth-title">Reset Password</h1>
    <p class="auth-subtitle">Enter your email and we'll send a reset link</p>
  </div>

  <% if (typeof flash !== 'undefined' && flash.success) { %>
    <div class="alert alert--success"><%= flash.success %></div>
  <% } %>
  <% if (typeof flash !== 'undefined' && flash.error) { %>
    <div class="alert alert--error"><%= flash.error %></div>
  <% } %>

  <form method="POST" action="/forgot-password" class="auth-form" novalidate>
    <div class="form-group">
      <label for="email" class="form-label">Email</label>
      <input
        type="email"
        id="email"
        name="email"
        class="form-input"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
    </div>
    <button type="submit" class="btn btn--primary btn--full">Send Reset Link</button>
  </form>

  <p class="auth-footer"><a href="/login">Back to Sign In</a></p>
</div>
