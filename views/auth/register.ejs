<div class="auth-card">
  <div class="auth-header">
    <img src="/HelloTasksIcon.png" alt="HelloTasks" class="auth-logo">
    <div class="auth-card-icon">
      <svg viewBox="0 0 20 20" fill="currentColor" width="22" height="22"><path d="M8 9a3 3 0 100-6 3 3 0 000 6zM8 11a6 6 0 016 6H2a6 6 0 016-6zM16 7a1 1 0 10-2 0v1h-1a1 1 0 100 2h1v1a1 1 0 102 0v-1h1a1 1 0 100-2h-1V7z"/></svg>
    </div>
    <h1 class="auth-title">Create Account</h1>
    <p class="auth-subtitle">Join HelloTasks — your account will need admin approval before you can sign in.</p>
  </div>

  <form method="POST" action="/register" class="auth-form" novalidate>
    <div class="form-row">
      <div class="form-group">
        <div class="form-float">
          <input
            type="text"
            id="firstName"
            name="firstName"
            class="form-input"
            required
            autocomplete="given-name"
            placeholder=" "
          />
          <label for="firstName" class="form-label">First Name</label>
        </div>
      </div>
      <div class="form-group">
        <div class="form-float">
          <input
            type="text"
            id="lastName"
            name="lastName"
            class="form-input"
            required
            autocomplete="family-name"
            placeholder=" "
          />
          <label for="lastName" class="form-label">Last Name</label>
        </div>
      </div>
    </div>
    <div class="form-group">
      <div class="form-float">
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          required
          autocomplete="email"
          placeholder=" "
        />
        <label for="email" class="form-label">Email</label>
      </div>
    </div>
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'password' }) %>
        <label for="password" class="form-label">Password</label>
      </div>
      <span class="form-hint">Min. 8 characters</span>
    </div>
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="form-input"
          required
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'confirmPassword' }) %>
        <label for="confirmPassword" class="form-label">Confirm Password</label>
      </div>
      <span class="form-error confirm-password-error" style="display:none">Passwords do not match.</span>
    </div>
    <% if (turnstileSiteKey) { %>
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-appearance="interaction-only"></div>
    <% } %>
    <button type="submit" class="btn btn--primary btn--full" data-loading-text="Creating account...">Create Account</button>
  </form>
  <% if (turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>

  <p class="auth-footer">Already have an account? <a href="/login">Sign in</a></p>
</div>
