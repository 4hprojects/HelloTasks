<div class="auth-card">
  <div class="auth-header">
    <img src="/HelloTasksIcon.png" alt="HelloTasks" class="auth-logo">
    <div class="auth-header-text">
      <h1 class="auth-title">Create Account</h1>
      <p class="auth-subtitle">Join HelloTasks — your account will need admin approval before you can sign in.</p>
    </div>
  </div>

  <form method="POST" action="/register" class="auth-form" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-row">
      <div class="form-group">
        <div class="form-float">
          <input
            type="text"
            id="firstName"
            name="firstName"
            class="form-input"
            required
            autocomplete="given-name"
            placeholder=" "
          />
          <label for="firstName" class="form-label">First Name</label>
        </div>
      </div>
      <div class="form-group">
        <div class="form-float">
          <input
            type="text"
            id="lastName"
            name="lastName"
            class="form-input"
            required
            autocomplete="family-name"
            placeholder=" "
          />
          <label for="lastName" class="form-label">Last Name</label>
        </div>
      </div>
    </div>
    <div class="form-group">
      <div class="form-float">
        <input
          type="email"
          id="email"
          name="email"
          class="form-input"
          required
          autocomplete="email"
          placeholder=" "
        />
        <label for="email" class="form-label">Email</label>
      </div>
    </div>
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="password"
          name="password"
          class="form-input"
          required
          minlength="8"
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'password' }) %>
        <label for="password" class="form-label">Password</label>
      </div>
      <div class="pw-strength" id="pwStrength" style="display:none">
        <div class="pw-strength-bar">
          <div class="pw-strength-fill" id="pwStrengthFill"></div>
        </div>
        <span class="pw-strength-label" id="pwStrengthLabel"></span>
      </div>
    </div>
    <div class="form-group">
      <div class="form-float form-input-wrapper">
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="form-input"
          required
          autocomplete="new-password"
          placeholder=" "
        />
        <%- include('../partials/password-toggle', { targetId: 'confirmPassword' }) %>
        <label for="confirmPassword" class="form-label">Confirm Password</label>
      </div>
      <span class="form-error confirm-password-error" style="display:none">Passwords do not match.</span>
    </div>
    <% if (turnstileSiteKey) { %>
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-appearance="interaction-only"></div>
    <% } %>
    <button type="submit" class="btn btn--primary btn--full" data-loading-text="Creating account...">Create Account</button>
  </form>
  <% if (turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>

  <p class="auth-footer">Already have an account? <a href="/login">Sign in</a></p>
</div>
<script>
(function () {
  var input = document.getElementById('password');
  var meter = document.getElementById('pwStrength');
  var fill  = document.getElementById('pwStrengthFill');
  var label = document.getElementById('pwStrengthLabel');

  function score(val) {
    if (val.length === 0) return 0;
    if (val.length < 8)   return 1;
    var types = 0;
    if (/[a-z]/.test(val)) types++;
    if (/[A-Z]/.test(val)) types++;
    if (/[0-9]/.test(val)) types++;
    return types >= 2 ? 3 : 2;
  }

  input.addEventListener('input', function () {
    var s = score(this.value);
    if (s === 0) { meter.style.display = 'none'; return; }
    meter.style.display = 'flex';
    fill.className = 'pw-strength-fill pw-strength-fill--' + ['', 'weak', 'fair', 'strong'][s];
    label.textContent = ['', 'Weak', 'Fair', 'Strong'][s];
    label.className   = 'pw-strength-label pw-strength-label--' + ['', 'weak', 'fair', 'strong'][s];
  });
}());
</script>
