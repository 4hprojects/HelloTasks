<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <% if (typeof pwaEnabled !== 'undefined' && pwaEnabled) { %>
  <meta name="theme-color" content="#1E40AF" />
  <meta name="description" content="Create private, customizable QR codes in your browser with HelloTasks." />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="QR Creator" />
  <link rel="manifest" href="/qr/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/qr/images/icon-180.png" />
  <% } %>
  <title><%= typeof title !== 'undefined' ? title : 'HelloTasks' %> — HelloTasks</title>
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/theme.css" />
  <link rel="stylesheet" href="/css/layout.css" />
  <link rel="stylesheet" href="/css/forms.css" />
  <link rel="stylesheet" href="/css/buttons.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/tasks.css" />
  <link rel="stylesheet" href="/css/responsive.css" />
  <% if (typeof pageStyles !== 'undefined') { pageStyles.forEach(function(href) { %>
  <link rel="stylesheet" href="<%= href %>" />
  <% }); } %>
</head>
<body class="<%= typeof user !== 'undefined' && user ? 'app-layout' : (typeof pageClass !== 'undefined' ? pageClass : 'auth-layout') %>">

<% if (typeof user !== 'undefined' && user) { %>
  <%- include('../partials/sidebar') %>
  <div class="app-main">
    <%- include('../partials/topbar') %>
    <div class="app-content">
      <%- include('../partials/flash-messages') %>
      <%- body %>
    </div>
  </div>
<% } else if (typeof pageClass !== 'undefined' && pageClass === 'qr-public-layout') { %>
  <%- include('../partials/flash-messages') %>
  <%- body %>
<% } else { %>
  <div class="auth-wrapper">
    <%- include('../partials/flash-messages') %>
    <%- body %>
  </div>
<% } %>

<script src="/js/main.js"></script>
<% if (typeof pageScripts !== 'undefined') { pageScripts.forEach(function(src) { %>
<script src="<%= src %>"></script>
<% }); } %>

<% if (typeof user !== 'undefined' && user) { %>
<div id="confirmModal" class="modal-overlay" role="dialog" aria-modal="true">
  <div class="modal">
    <p class="modal-message" id="confirmModalMsg"></p>
    <div class="modal-actions">
      <button class="btn btn--ghost btn--sm" id="confirmModalCancel">Cancel</button>
      <button class="btn btn--danger btn--sm" id="confirmModalOk">Confirm</button>
    </div>
  </div>
</div>
<% } %>
</body>
</html>
